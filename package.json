{
  "name": "disputeflow-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloud-native transaction dispute and evidence management platform",
  "workspaces": [
    "services/*",
    "analytics"
  ],
  "scripts": {
    "start:disputes": "npm start --workspace services/dispute-service",
    "start:evidence": "npm start --workspace services/evidence-service",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "smoke": "node scripts/smoke-test.mjs",
    "etl:export": "npm run export --workspace analytics",
    "etl:load": "npm run load --workspace analytics"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "globals": "^16.2.0",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
